---
/**
 * Hero illustration: an example lead-intake automation, drawn as nodes on a
 * dotted field (no card around it, so nothing nests). Decorative, not real data.
 */
const outputs = [
  { y: 70, title: "Lead logged", meta: "Google Sheet" },
  { y: 200, title: "Reply sent", meta: "With call times" },
  { y: 330, title: "Team alerted", meta: "On Telegram" },
];
const paths = ["M158 200 L210 200", ...outputs.map((o) => `M330 200 C356 200 346 ${o.y} 372 ${o.y}`)];
const pct = (x: number, y: number) => `left:${(x / 560) * 100}%;top:${(y / 400) * 100}%`;
---

<figure class="relative hidden sm:block" aria-label="Illustration: an example automation where a WhatsApp message is handled by an AI agent">
  <div class="flow-canvas relative aspect-[560/400] w-full" aria-hidden="true">
    <svg viewBox="0 0 560 400" class="absolute inset-0 h-full w-full" fill="none">
      {
        paths.map((d, i) => (
          <g>
            <path d={d} stroke="var(--color-border)" stroke-width="2" />
            <circle r="4" fill="var(--color-accent)" class="flow-dot" opacity="0">
              <set attributeName="opacity" to="1" begin={`${0.4 + i * 0.35}s`} />
              <animateMotion dur={i === 0 ? "1.4s" : "1.8s"} begin={`${0.4 + i * 0.35}s`} repeatCount="indefinite" path={d} />
            </circle>
          </g>
        ))
      }
    </svg>

    <div class="flow-node w-[27%]" style={pct(8, 200)}>
      <span class="flow-icon bg-success/15 text-success">
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path></svg>
      </span>
      <span class="min-w-0">
        <span class="block truncate text-xs font-semibold">WhatsApp</span>
        <span class="hidden truncate text-xs text-muted-foreground lg:block">"Can I book?"</span>
      </span>
    </div>

    <div class="absolute flex w-[21%] -translate-x-1/2 -translate-y-1/2 flex-col items-center rounded-2xl bg-inverse px-2 py-4 text-center text-inverse-foreground ring-1 ring-white/10 shadow-[0_12px_28px_-10px_rgb(0_0_0/0.45)]" style={pct(270, 200)}>
      <span class="mb-2 flex h-10 w-10 items-center justify-center rounded-xl bg-accent text-accent-foreground">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path d="M15 13v2M9 13v2"></path></svg>
      </span>
      <span class="text-sm font-semibold">AI agent</span>
      <span class="text-xs text-inverse-muted">your documents</span>
    </div>

    {
      outputs.map((o) => (
        <div class="flow-node w-[32%]" style={pct(372, o.y)}>
          <span class="flow-icon bg-accent-soft text-accent">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5" /></svg>
          </span>
          <span class="min-w-0">
            <span class="block truncate text-xs font-semibold">{o.title}</span>
            <span class="hidden truncate text-xs text-muted-foreground lg:block">{o.meta}</span>
          </span>
        </div>
      ))
    }
  </div>
  <figcaption class="mt-3 text-sm text-muted-foreground">Example: a WhatsApp enquiry answered, logged and passed to your team in seconds.</figcaption>
</figure>

<style>
  /* Dotted field fades out at the edges; the nodes above it stay fully opaque. */
  .flow-canvas::before {
    content: "";
    position: absolute;
    inset: -4%;
    background-image: radial-gradient(color-mix(in oklch, var(--color-foreground) 13%, transparent) 1px, transparent 1px);
    background-size: 18px 18px;
    mask-image: radial-gradient(ellipse at center, black 50%, transparent 80%);
  }
  .flow-node {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transform: translateY(-50%);
    border-radius: 0.75rem;
    background: var(--color-card);
    padding: 0.45rem 0.6rem;
    box-shadow: 0 6px 16px -8px rgb(0 0 0 / 0.3);
  }
  .flow-icon {
    display: flex;
    height: 1.75rem;
    width: 1.75rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .flow-dot {
      display: none;
    }
  }
</style>
