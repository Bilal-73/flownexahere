---
/**
 * Hero illustration, ported from the old React/framer-motion FlowDiagram to
 * static SVG + CSS. Decorative: an example lead-intake workflow, not real data.
 */
const outputs = [
  { y: 70, title: "Lead logged", meta: "Intent: booking" },
  { y: 200, title: "Reply sent", meta: "Answer + booking link" },
  { y: 330, title: "Team alerted", meta: "Telegram · hot lead" },
];
const paths = ["M158 200 L210 200", ...outputs.map((o) => `M330 200 C362 200 352 ${o.y} 384 ${o.y}`)];
const pct = (x: number, y: number) => `left:${(x / 560) * 100}%;top:${(y / 400) * 100}%`;
---

<figure class="relative hidden w-full sm:block" aria-label="Illustration: an example automation where a WhatsApp message is handled by an AI agent">
  <div class="card relative overflow-hidden p-3 shadow-[0_30px_80px_-30px_rgb(80_40_10/0.35)] sm:p-5">
    <div class="mb-3 flex items-center justify-between">
      <div class="flex gap-1.5" aria-hidden="true">
        <span class="h-2.5 w-2.5 rounded-full bg-border"></span><span class="h-2.5 w-2.5 rounded-full bg-border"></span><span class="h-2.5 w-2.5 rounded-full bg-border"></span>
      </div>
      <span class="flex items-center gap-2 rounded-full bg-muted px-3 py-1 text-[11px] font-medium text-muted-foreground">
        <span class="h-1.5 w-1.5 rounded-full bg-success"></span> example: lead-intake workflow
      </span>
    </div>
    <div class="flow-canvas relative aspect-[560/400] w-full rounded-xl" aria-hidden="true">
      <svg viewBox="0 0 560 400" class="absolute inset-0 h-full w-full" fill="none">
        {
          paths.map((d, i) => (
            <g>
              <path d={d} stroke="var(--color-border)" stroke-width="2" />
              <circle r="4" fill="var(--color-accent)" class="flow-dot">
                <animateMotion dur={i === 0 ? "1.4s" : "1.8s"} begin={`${0.4 + i * 0.35}s`} repeatCount="indefinite" path={d} />
              </circle>
            </g>
          ))
        }
      </svg>

      <div class="flow-node w-[27%]" style={pct(8, 200)}>
        <span class="flow-icon bg-success/15 text-success">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path></svg>
        </span>
        <span class="min-w-0">
          <span class="block truncate text-[10px] font-semibold sm:text-xs">WhatsApp</span>
          <span class="hidden truncate text-[11px] text-muted-foreground sm:block">"Can I book a demo?"</span>
        </span>
      </div>

      <div class="absolute flex w-[21%] -translate-x-1/2 -translate-y-1/2 flex-col items-center rounded-2xl bg-inverse px-2 py-3 text-center text-inverse-foreground shadow-xl sm:py-4" style={pct(270, 200)}>
        <span class="mb-2 flex h-9 w-9 items-center justify-center rounded-xl bg-accent text-accent-foreground sm:h-11 sm:w-11">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path d="M15 13v2M9 13v2"></path></svg>
        </span>
        <span class="text-[11px] font-semibold sm:text-sm">AI agent</span>
        <span class="text-[9px] text-inverse-muted sm:text-[11px]">RAG · tools</span>
      </div>

      {
        outputs.map((o) => (
          <div class="flow-node w-[31%]" style={pct(384, o.y)}>
            <span class="flow-icon bg-accent-soft text-accent">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5" /></svg>
            </span>
            <span class="min-w-0">
              <span class="block truncate text-[10px] font-semibold sm:text-xs">{o.title}</span>
              <span class="hidden truncate text-[11px] text-muted-foreground sm:block">{o.meta}</span>
            </span>
          </div>
        ))
      }
    </div>
  </div>
</figure>

<style>
  .flow-canvas {
    background-color: color-mix(in oklch, var(--color-background) 60%, transparent);
    background-image: radial-gradient(color-mix(in oklch, var(--color-foreground) 10%, transparent) 1px, transparent 1px);
    background-size: 18px 18px;
  }
  .flow-node {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transform: translateY(-50%);
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
    background: var(--color-card);
    padding: 0.4rem 0.5rem;
    box-shadow: 0 4px 14px -6px rgb(0 0 0 / 0.15);
  }
  .flow-icon {
    display: flex;
    height: 1.75rem;
    width: 1.75rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .flow-dot {
      display: none;
    }
  }
</style>
