---
import Icon from "../Icon.astro";
import { site } from "@/config/site";
const c = site.cricnexa;
---

<section class="container-page py-8" aria-labelledby="cricnexa-teaser">
  <a href="/cricnexa/" class="group card flex flex-col gap-4 p-6 transition-shadow hover:shadow-lg sm:flex-row sm:items-center sm:justify-between sm:p-8" data-track="home_cricnexa">
    <div class="flex gap-4">
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent-soft text-accent"><Icon name="trophy" /></span>
      <div>
        <p class="text-xs font-semibold tracking-[0.12em] text-accent uppercase">Coming soon · A FlowNexa product</p>
        <h2 id="cricnexa-teaser" class="mt-1 text-xl">{c.name}: {c.headline}</h2>
      </div>
    </div>
    <span class="inline-flex shrink-0 items-center gap-1.5 font-semibold group-hover:text-accent">
      Join the waitlist <Icon name="arrow-right" class="h-4 w-4" />
    </span>
  </a>
</section>
