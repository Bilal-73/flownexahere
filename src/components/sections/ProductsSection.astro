---
/**
 * "Our own products": FlowNexa's in-house software (type: product), in `order`.
 * One panel split into columns, matching the packages panel; each product
 * names its status honestly and links to its page when it has one.
 */
import Icon from "../Icon.astro";
import { getListedProjects, projectHref, statusLabel } from "@/lib/projects";

interface Props {
  headingLevel?: "h2" | "h3";
}
const { headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
const Sub = headingLevel === "h2" ? "h3" : "h4";

const products = (await getListedProjects()).filter((p) => p.data.type === "product");
const linkLabel = (slug: string, href?: string) =>
  !href ? undefined : slug === "cricnexa" ? "Join the waitlist" : "See the product";
---

{
  products.length > 0 && (
    <section class="border-t border-border py-16 md:py-24" aria-labelledby="products-heading">
      <div class="container-page">
        <div class="max-w-2xl">
          <Heading id="products-heading" class="text-3xl md:text-4xl">
            Our own products
          </Heading>
          <p class="mt-3 text-muted-foreground">
            Alongside client work, we build software of our own. It keeps our engineering honest: we live with what we ship.
          </p>
        </div>

        <ul
          class:list={[
            "mt-10 grid overflow-hidden rounded-[var(--radius-card)] border border-border bg-card",
            products.length >= 3 ? "lg:grid-cols-3" : products.length === 2 ? "md:grid-cols-2" : "",
          ]}
        >
          {products.map((p) => {
            const href = projectHref(p);
            const label = linkLabel(p.id, href);
            return (
              <li class="relative flex flex-col p-6 sm:p-8 [&:not(:first-child)]:border-t [&:not(:first-child)]:border-border lg:[&:not(:first-child)]:border-t-0 lg:[&:not(:first-child)]:border-l">
                <div class="flex items-center justify-between gap-3">
                  <Sub class="text-2xl">{p.data.title.split(":")[0]}</Sub>
                  <span class="rounded-full bg-accent-soft px-2.5 py-0.5 text-xs font-semibold text-accent">{statusLabel(p)}</span>
                </div>
                <p class="mt-3 leading-relaxed text-muted-foreground">{p.data.summary}</p>
                <div class="mt-auto pt-6">
                  {href && label ? (
                    <a href={href} class="inline-flex items-center gap-1.5 font-semibold hover:text-accent after:absolute after:inset-0" data-track={`product_${p.id}`}>
                      {label} <Icon name="arrow-right" class="h-4 w-4" />
                    </a>
                  ) : (
                    <span class="text-sm text-muted-foreground">More soon</span>
                  )}
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )
}
