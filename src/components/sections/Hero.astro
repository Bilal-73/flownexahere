---
import Icon from "../Icon.astro";
import FlowDiagram from "./FlowDiagram.astro";
import { bookingHref, site, whatsappUrl } from "@/config/site";

const booking = bookingHref();
const external = booking.startsWith("http");
---

<section class="relative overflow-hidden pt-12 pb-8 sm:pt-16 md:pt-20 md:pb-12">
  <div
    class="pointer-events-none absolute top-0 right-0 -z-10 h-[34rem] w-[34rem] translate-x-1/3 -translate-y-1/4 rounded-full opacity-60 blur-3xl"
    style="background: radial-gradient(circle, color-mix(in oklch, var(--color-accent) 22%, transparent), transparent 65%)"
    aria-hidden="true"
  >
  </div>
  <div class="container-page grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr]">
    <div>
      <p class="eyebrow">AI engineering agency</p>
      <h1 class="mt-4 text-[2.4rem] leading-[1.05] sm:text-5xl lg:text-[3.6rem]">
        AI chatbots and automations that <span class="text-accent">handle your repetitive work</span>.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground">
        We build RAG chatbots, n8n and Python automations and data dashboards for small businesses
        and founders, with fixed scopes, clear prices and code you own.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={booking} class="btn btn-primary" data-track="hero_book_call" {...external ? { target: "_blank", rel: "noopener" } : {}}>
          <Icon name="calendar" class="h-4 w-4" /> Book a free 15-min call
        </a>
        <a href={whatsappUrl()} class="btn btn-secondary" target="_blank" rel="noopener" data-track="hero_whatsapp">
          <Icon name="whatsapp" class="h-4 w-4" /> Chat on WhatsApp
        </a>
      </div>
      <p class="mt-5 text-sm text-muted-foreground">
        Prefer to look first? <a href="/work/" class="link">See our work</a> · We reply {site.contact.replyTime}.
      </p>
    </div>
    <FlowDiagram />
  </div>
</section>
