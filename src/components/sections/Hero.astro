---
import { Image } from "astro:assets";
import Icon from "../Icon.astro";
import FlowDiagram from "./FlowDiagram.astro";
import founderPhoto from "@/assets/team/bilal-imran.jpg";
import { bookingHref, callCta, callCtaNote, site, whatsappUrl } from "@/config/site";

const booking = bookingHref();
const external = booking.startsWith("http");
---

<section class="relative overflow-hidden pt-10 pb-14 sm:pt-16 md:pt-20 md:pb-20">
  <div class="container-page grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
    <div>
      <h1 class="text-[2.35rem] leading-[1.05] sm:text-5xl lg:text-[3.5rem]">
        AI chatbots and automations that <span class="text-accent">handle your repetitive work</span>.
      </h1>
      <p class="mt-6 max-w-[34rem] text-lg leading-relaxed text-muted-foreground">
        A chatbot that answers your customers. Automations that move leads, orders and documents
        between your tools. Fixed price, usually ready in one to two weeks, and the code is yours.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={booking} class="btn btn-primary" data-track="hero_call" {...external ? { target: "_blank", rel: "noopener" } : {}}>
          <Icon name="calendar" class="h-4 w-4" />
          {callCta()}
        </a>
        <a href={whatsappUrl()} class="btn btn-secondary" target="_blank" rel="noopener" data-track="hero_whatsapp">
          <Icon name="whatsapp" class="h-4 w-4" /> WhatsApp us
        </a>
      </div>
      <p class="mt-3 text-sm text-muted-foreground">{callCtaNote()}</p>

      <a href="/about/" class="group mt-10 inline-flex items-center gap-3.5 rounded-full py-1 pr-4">
        <Image
          src={founderPhoto}
          alt=""
          widths={[96, 144]}
          sizes="48px"
          class="h-12 w-12 rounded-full object-cover object-top ring-2 ring-card"
          loading="eager"
        />
        <span class="text-sm leading-snug">
          <span class="block font-semibold group-hover:text-accent">{site.founder.name}, founder</span>
          <span class="text-muted-foreground">You work with the engineer who builds it.</span>
        </span>
      </a>
    </div>
    <FlowDiagram />
  </div>
</section>
