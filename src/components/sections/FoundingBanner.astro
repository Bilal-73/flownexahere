---
import Icon from "../Icon.astro";
import { bookingHref, site } from "@/config/site";
const { enabled, text, detail } = site.foundingOffer;
const booking = bookingHref();
---

{
  enabled && (
    <section aria-label="Founding-client offer" class="container-page">
      <div class="flex flex-col gap-4 rounded-[var(--radius-card)] bg-inverse p-6 text-inverse-foreground sm:flex-row sm:items-center sm:justify-between sm:p-8">
        <div class="flex gap-4">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-inverse-accent text-inverse">
            <Icon name="sparkles" class="h-5 w-5" />
          </span>
          <div>
            <p class="text-lg font-semibold">{text}</p>
            <p class="mt-1 text-sm text-inverse-muted">{detail}</p>
          </div>
        </div>
        <a href={booking} class="btn btn-inverse shrink-0" data-track="founding_offer_cta" {...(booking.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}>
          Claim a spot
        </a>
      </div>
    </section>
  )
}
