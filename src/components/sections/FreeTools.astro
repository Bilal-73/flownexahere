---
/**
 * Home "Free tools" section: the tools from src/config/tools.ts as cards.
 * Runs entirely in the browser; each tool ends with a CTA to a matching package.
 */
import Icon from "../Icon.astro";
import ToolCard from "../ToolCard.astro";
import { tools } from "@/config/tools";
---

<section class="border-t border-border py-16 md:py-24" aria-labelledby="free-tools-heading">
  <div class="container-page">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-2xl">
        <h2 id="free-tools-heading" class="text-3xl md:text-4xl">Free tools</h2>
        <p class="mt-3 text-muted-foreground">
          Work out what automation is worth to you before you talk to anyone. No sign-up, and nothing you type leaves your browser.
        </p>
      </div>
      <a href="/tools/" class="inline-flex shrink-0 items-center gap-1.5 font-semibold hover:text-accent" data-track="home_all_tools">
        All free tools <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>

    <ul class="mt-10 grid gap-4 md:grid-cols-3">
      {tools.map((tool) => <ToolCard tool={tool} track="home_tool" />)}
    </ul>
  </div>
</section>
