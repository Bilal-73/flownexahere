---
import { site } from "@/config/site";
interface Props {
  headingLevel?: "h2" | "h3";
}
const { headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
---

<section class="py-16 md:py-24" aria-labelledby="process-heading">
  <div class="container-page">
    <div class="max-w-2xl">
      <Heading id="process-heading" class="text-3xl md:text-4xl">From first call to handover.</Heading>
      <p class="mt-3 text-muted-foreground">Small team, short loops, no 80-page decks. Typical timeline for a fixed-scope package:</p>
    </div>
    <ol class="mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        site.process.map((step, i) => (
          <li class="border-t-2 border-foreground pt-5 first:border-accent">
            <p class="text-sm text-muted-foreground">
              Step {i + 1} · <span class="font-semibold text-accent">{step.time}</span>
            </p>
            <h3 class="mt-2 text-xl">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
