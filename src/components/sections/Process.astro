---
import { site } from "@/config/site";
interface Props {
  headingLevel?: "h2" | "h3";
}
const { headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
---

<section class="py-16 md:py-24" aria-labelledby="process-heading">
  <div class="container-page grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <p class="eyebrow">How we work</p>
      <Heading id="process-heading" class="mt-3 text-3xl md:text-4xl">From first call to handover.</Heading>
      <p class="mt-4 text-muted-foreground">
        Small team, short loops, no 80-page decks. Typical timelines for a fixed-scope package:
      </p>
    </div>
    <ol class="grid gap-5 sm:grid-cols-2 lg:col-span-8">
      {
        site.process.map((step, i) => (
          <li class="card p-6">
            <div class="flex items-baseline justify-between gap-4">
              <span class="font-mono text-sm text-muted-foreground">0{i + 1}</span>
              <span class="text-xs font-semibold tracking-[0.12em] text-accent uppercase">{step.time}</span>
            </div>
            <h3 class="mt-3 text-xl">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
