---
import { site } from "@/config/site";
import Icon from "../Icon.astro";
---

<section class="py-16 md:py-24" aria-labelledby="faq-heading">
  <div class="container-page grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-heading" class="mt-3 text-3xl md:text-4xl">Straight answers.</h2>
      <p class="mt-4 text-muted-foreground">Pricing, timelines, data and ownership. Anything else, just ask.</p>
    </div>
    <div class="divide-y divide-border border-y border-border lg:col-span-8">
      {
        site.faq.map((item) => (
          <details class="group py-1">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-left text-lg font-semibold [&::-webkit-details-marker]:hidden">
              {item.q}
              <Icon name="plus" class="h-5 w-5 shrink-0 text-accent transition-transform group-open:rotate-45" />
            </summary>
            <p class="pb-5 leading-relaxed text-muted-foreground">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
