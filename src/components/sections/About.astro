---
import { Image } from "astro:assets";
import { site } from "@/config/site";
import Icon from "../Icon.astro";

interface Props {
  /** Show the team grid (About page) or only the founder story (home). */
  showTeam?: boolean;
  headingLevel?: "h1" | "h2";
}
const { showTeam = false, headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
// Sub-headings sit one level below the section heading (never skip levels).
const Sub = headingLevel === "h1" ? "h2" : "h3";

const photos = import.meta.glob<{ default: ImageMetadata }>("/src/assets/team/*.{jpg,jpeg,png}", { eager: true });
const photoFor = (key: string) => Object.entries(photos).find(([path]) => path.includes(`/${key}.`))?.[1].default;
const founderPhoto = photoFor(site.team[0].photo);
---

<section class="py-16 md:py-24" aria-labelledby="about-heading">
  <div class="container-page grid gap-10 lg:grid-cols-12 lg:items-start">
    <div class="lg:col-span-7">
      <Heading id="about-heading" class="text-3xl md:text-4xl">Built for execution. Grounded in craft.</Heading>
      <div class="mt-6 space-y-4 text-lg leading-relaxed text-muted-foreground">
        {site.founder.story.map((p) => <p>{p}</p>)}
      </div>
      <p class="mt-4 text-sm font-semibold">
        {site.founder.name}, {site.founder.role}
      </p>

      <div class="mt-10">
        <Sub class="text-sm font-semibold text-muted-foreground">Tools we work with</Sub>
        <ul class="mt-4 flex flex-wrap gap-2">
          {site.skills.map((s) => <li class="chip !text-sm">{s}</li>)}
        </ul>
      </div>

      {
        site.credentials.length > 0 && (
          <div class="mt-8">
            <Sub class="text-sm font-semibold text-muted-foreground">Credentials</Sub>
            <ul class="mt-4 flex flex-wrap gap-2">
              {site.credentials.map((c) => (
                <li>
                  {c.url ? (
                    <a href={c.url} target="_blank" rel="noopener" class="chip gap-1.5 !text-sm hover:border-accent">
                      <Icon name="shield" class="h-3.5 w-3.5 text-accent" /> {c.issuer}: {c.title}
                      {c.year && ` (${c.year})`}
                    </a>
                  ) : (
                    <span class="chip gap-1.5 !text-sm">
                      <Icon name="shield" class="h-3.5 w-3.5 text-accent" /> {c.issuer}: {c.title}
                      {c.year && ` (${c.year})`}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )
      }
      {
        import.meta.env.DEV && site.credentials.length === 0 && (
          <p class="mt-8 inline-block rounded bg-yellow-300 px-2 py-1 text-xs font-bold text-black">
            TODO: add DataCamp certifications in src/config/site.ts → credentials
          </p>
        )
      }
    </div>

    {
      !showTeam && founderPhoto && (
        <div class="lg:col-span-4 lg:col-start-9">
          <Image
            src={founderPhoto}
            alt={`${site.founder.name}, ${site.founder.role}`}
            widths={[320, 480, 640]}
            sizes="(min-width: 1024px) 28vw, 80vw"
            class="aspect-[4/5] w-full max-w-sm rounded-[var(--radius-card)] border border-border object-cover"
          />
        </div>
      )
    }
  </div>

  {
    showTeam && (
      <div id="team" class="container-page mt-16 scroll-mt-24">
        <h2 class="text-2xl md:text-3xl">The team</h2>
        <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {site.team.map((m) => {
            const photo = photoFor(m.photo);
            return (
              <li class="card overflow-hidden">
                {photo && (
                  <Image
                    src={photo}
                    alt={`${m.name}, ${m.role}`}
                    widths={[320, 480, 640]}
                    sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw"
                    class="aspect-[4/5] w-full object-cover object-top"
                  />
                )}
                <div class="p-5">
                  <p class="text-lg font-semibold">{m.name}</p>
                  <p class="text-sm text-muted-foreground">{m.role}</p>
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    )
  }
</section>
