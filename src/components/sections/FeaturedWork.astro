---
import ProjectCard from "../ProjectCard.astro";
import Icon from "../Icon.astro";
import { getProjects } from "@/lib/projects";

const featured = (await getProjects()).filter((p) => p.data.featured).slice(0, 6);
---

<section class="py-16 md:py-24" aria-labelledby="work-heading">
  <div class="container-page">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 id="work-heading" class="mt-3 text-3xl md:text-4xl">Shipped, not slideware.</h2>
        <p class="mt-3 max-w-2xl text-muted-foreground">
          Demo builds and products that show what we can do. Each one is labelled honestly: demo, product or client work.
        </p>
      </div>
      <a href="/work/" class="inline-flex items-center gap-1.5 font-semibold hover:text-accent" data-track="home_all_work">
        All projects <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
  </div>
</section>
