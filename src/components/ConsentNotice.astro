---
/** Minimal consent notice. Rendered only when GA4 is configured (PUBLIC_GA_ID). */
const gaId = import.meta.env.PUBLIC_GA_ID?.trim();
---

{
  gaId && (
    <div
      id="consent-notice"
      hidden
      role="region"
      aria-label="Analytics consent"
      class="card fixed inset-x-4 bottom-4 z-50 mx-auto max-w-xl p-4 shadow-lg sm:p-5"
    >
      <p class="text-sm leading-relaxed">
        We'd like to use Google Analytics to understand which pages are useful. It sets cookies.
        Cookieless Cloudflare analytics runs either way. <a href="/privacy/" class="link">Privacy</a>
      </p>
      <div class="mt-3 flex flex-wrap gap-2">
        <button type="button" class="btn btn-primary !min-h-10 !py-2 text-sm" data-consent="granted">
          Allow analytics
        </button>
        <button type="button" class="btn btn-secondary !min-h-10 !py-2 text-sm" data-consent="denied">
          No thanks
        </button>
      </div>
    </div>
  )
}
