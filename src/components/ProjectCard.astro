---
import ProjectCover from "./ProjectCover.astro";
import Icon from "./Icon.astro";
import { projectHref, statusLabel, typeLabel, type Project } from "@/lib/projects";

interface Props {
  project: Project;
  headingLevel?: "h2" | "h3";
  eager?: boolean;
}
const { project, headingLevel = "h3", eager = false } = Astro.props;
const href = projectHref(project);
const { title, summary, tag, tech, status, services } = project.data;
const Heading = headingLevel;
const Wrapper = href ? "a" : "div";
const isDraft = status === "draft";
---

<article
  class="group relative flex h-full flex-col overflow-hidden rounded-[var(--radius-card)] border border-border bg-card transition-colors hover:border-foreground/40"
  data-project
  data-services={services.join(" ")}
  data-tech={tech.map((t) => t.toLowerCase()).join("|")}
>
  <div class="relative aspect-[16/10] overflow-hidden border-b border-border bg-muted">
    <ProjectCover project={project} eager={eager} />
    <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
      <span
        class:list={[
          "rounded-full px-2.5 py-1 text-xs font-semibold",
          isDraft ? "bg-yellow-300 text-black" : status === "live" ? "bg-success text-white" : "bg-inverse/85 text-inverse-foreground",
        ]}
      >
        {statusLabel(project)}
      </span>
    </div>
  </div>
  <div class="flex flex-1 flex-col p-5">
    <Heading class="text-xl leading-snug">
      <Wrapper href={href} class={href ? "after:absolute after:inset-0 focus-visible:outline-none group-focus-within:underline" : undefined}>
        {title}
      </Wrapper>
    </Heading>
    {tag && <p class="mt-1 text-sm font-medium text-accent">{tag}</p>}
    <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{summary}</p>
    {
      tech.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Tech">
          {tech.slice(0, 5).map((t) => (
            <li class="chip">{t}</li>
          ))}
        </ul>
      )
    }
    <div class="mt-auto flex items-center justify-between pt-5 text-sm">
      <span class="text-muted-foreground">{typeLabel(project)}</span>
      {
        href ? (
          <span class="inline-flex items-center gap-1 font-semibold text-foreground group-hover:text-accent">
            {project.data.caseStudy ? "Case study" : "Learn more"}
            <Icon name="arrow-up-right" class="h-4 w-4" />
          </span>
        ) : (
          <span class="text-xs text-muted-foreground">No public case study yet</span>
        )
      }
    </div>
  </div>
</article>
