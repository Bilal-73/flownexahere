export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  class?: string;
  label?: string;
  strokeWidth?: number;
}

const { name, class: className = "h-5 w-5", label, strokeWidth = 1.9 } = Astro.props;
const body = icons[name] ?? icons.link;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={label ? undefined : "true"}
  role={label ? "img" : undefined}
  aria-label={label}
  focusable="false"
  set:html={body}
/>
