---
/**
 * Shared shell for every free tool under /tools/<slug>/:
 * breadcrumb → heading + intro → the tool (default slot) → "How it works"
 * (named slot "method", optional) → CTA to the matching contact-form topic.
 *
 * Usage:
 *   <ToolLayout title="… | FlowNexa" description="…" heading="…" intro="…"
 *     toolName="AI ROI Calculator" path="/tools/roi-calculator/" contactTopic="workflow-automation">
 *     …tool markup…
 *     <Fragment slot="method">…formula & assumptions…</Fragment>
 *   </ToolLayout>
 */
import BaseLayout from "./BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import type { ServiceKey } from "@/config/site";
import { breadcrumbLd } from "@/lib/schema";

interface Props {
  /** SEO <title>; unique per tool. */
  title: string;
  /** Meta / OG description; unique per tool. */
  description: string;
  /** Path to the 1200×630 share image (defaults to the site image). */
  ogImage?: string;
  ogImageAlt?: string;
  /** Visible H1. */
  heading: string;
  intro: string;
  /** Short name used in the breadcrumb. */
  toolName: string;
  /** Canonical path, e.g. "/tools/roi-calculator/". */
  path: string;
  /** Contact-form topic the CTA preselects (matches ContactForm.astro keys). */
  contactTopic: ServiceKey | "call" | "other";
  ctaTitle?: string;
  ctaBody?: string;
  ctaLabel?: string;
}

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  heading,
  intro,
  toolName,
  path,
  contactTopic,
  ctaTitle = "Want this working for your team?",
  ctaBody = "Tell us which tasks eat your week. We'll reply with what we'd automate first and a fixed price.",
  ctaLabel = "Talk to us about it",
} = Astro.props;

const contactHref = `/contact/?topic=${encodeURIComponent(contactTopic)}#contact-form`;
const crumbs = [
  { name: "Home", path: "/" },
  { name: "Free tools", path: "/tools/" },
  { name: toolName, path },
];
---

<BaseLayout title={title} description={description} image={ogImage} imageAlt={ogImageAlt} jsonLd={[breadcrumbLd(crumbs)]}>
  <section class="container-page pt-10 pb-12 md:pt-14">
    <nav aria-label="Breadcrumb" class="text-sm text-muted-foreground">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/tools/" class="hover:text-foreground">Free tools</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-foreground">{toolName}</li>
      </ol>
    </nav>
    <h1 class="mt-4 max-w-3xl text-4xl md:text-5xl">{heading}</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted-foreground">{intro}</p>

    <div class="mt-10">
      <slot />
    </div>
  </section>

  {
    Astro.slots.has("method") && (
      <section class="border-t border-border py-14 md:py-16" aria-labelledby="method-heading">
        <div class="container-page max-w-4xl">
          <h2 id="method-heading" class="text-2xl md:text-3xl">How it works</h2>
          <div class="prose-fn mt-6">
            <slot name="method" />
          </div>
        </div>
      </section>
    )
  }

  <section class="border-t border-border py-14 md:py-16" aria-labelledby="tool-cta-heading">
    <div class="container-page">
      <div class="flex flex-col gap-6 rounded-[var(--radius-card)] bg-inverse p-6 text-inverse-foreground sm:p-10 md:flex-row md:items-center md:justify-between">
        <div class="max-w-2xl">
          <h2 id="tool-cta-heading" class="text-2xl md:text-3xl">{ctaTitle}</h2>
          <p class="mt-3 text-inverse-muted">{ctaBody}</p>
        </div>
        <a href={contactHref} class="btn btn-inverse shrink-0" data-track={`tool_cta_${path.split("/").filter(Boolean).pop()}`}>
          {ctaLabel} <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
