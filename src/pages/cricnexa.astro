---
import BaseLayout from "@/layouts/BaseLayout.astro";
import WaitlistForm from "@/components/WaitlistForm.astro";
import Logo from "@/components/Logo.astro";
import { site } from "@/config/site";
import { breadcrumbLd } from "@/lib/schema";

const c = site.cricnexa;
const productLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: c.name,
  applicationCategory: "SportsApplication",
  description: c.headline,
  creator: { "@type": "Organization", "@id": `${site.url}/#organization`, name: site.name },
  url: `${site.url}/cricnexa/`,
};
---

<BaseLayout
  title={`${c.name}: cricket scoring & match analytics (coming soon) | a FlowNexa product`}
  description={`${c.headline} Join the waitlist for early access.`}
  image="/og/cricnexa.png"
  imageAlt={`${c.name}: cricket scoring and match analytics, coming soon. A FlowNexa product.`}
  jsonLd={[productLd, breadcrumbLd([{ name: "Home", path: "/" }, { name: c.name, path: "/cricnexa/" }])]}
>
  <section class="pt-12 pb-16 md:pt-16 md:pb-24">
    <div class="container-page grid items-start gap-12 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="lg:pt-6">
        <p class="flex items-center gap-2 text-sm font-medium text-muted-foreground">
          <Logo class="h-6 w-6" /> A FlowNexa product
          <span class="rounded-full bg-accent-soft px-2.5 py-0.5 text-xs font-semibold text-accent">{c.status}</span>
        </p>
        <h1 class="mt-6 text-5xl md:text-6xl">{c.name}</h1>
        <p class="mt-4 text-2xl leading-snug font-medium">{c.headline}</p>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted-foreground">{c.intro}</p>
        <p class="mt-6 text-sm text-muted-foreground">
          <strong class="font-semibold text-foreground">For:</strong> {c.audience.join(" · ")}
        </p>
      </div>

      <div id="waitlist" class="scroll-mt-24 rounded-[var(--radius-card)] border border-border bg-card p-6 sm:p-8">
        <h2 id="cn-waitlist" class="text-2xl">Join the waitlist</h2>
        <p class="mt-2 mb-6 text-muted-foreground">
          Get early access and help shape what we build. We especially want to hear from clubs and academies that score matches every week.
        </p>
        <WaitlistForm />
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-muted/40 py-16" aria-labelledby="cn-planned">
    <div class="container-page">
      <h2 id="cn-planned" class="text-3xl">What we're building</h2>
      <ul class="mt-8 grid gap-5 md:grid-cols-3">
        {
          c.plannedFeatures.map((f) => (
            <li class="card p-6">
              <h3 class="text-lg">{f.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{f.body}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-2 text-sm text-muted-foreground">{c.disclaimer}</p>
    </div>
  </section>

</BaseLayout>
