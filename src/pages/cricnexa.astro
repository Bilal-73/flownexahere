---
import BaseLayout from "@/layouts/BaseLayout.astro";
import WaitlistForm from "@/components/WaitlistForm.astro";
import Icon from "@/components/Icon.astro";
import Logo from "@/components/Logo.astro";
import { site } from "@/config/site";
import { breadcrumbLd } from "@/lib/schema";

const c = site.cricnexa;
const productLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: c.name,
  applicationCategory: "SportsApplication",
  description: c.headline,
  creator: { "@type": "Organization", "@id": `${site.url}/#organization`, name: site.name },
  url: `${site.url}/cricnexa/`,
};
---

<BaseLayout
  title={`${c.name}: cricket scoring & match analytics (coming soon) | a FlowNexa product`}
  description={`${c.headline} Join the waitlist for early access.`}
  image="/og/cricnexa.png"
  imageAlt={`${c.name}: cricket scoring and match analytics, coming soon. A FlowNexa product.`}
  jsonLd={[productLd, breadcrumbLd([{ name: "Home", path: "/" }, { name: c.name, path: "/cricnexa/" }])]}
>
  <section class="relative overflow-hidden pt-12 pb-16 md:pt-16 md:pb-24">
    <div class="container-page grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="inline-flex items-center gap-2 text-sm font-medium text-muted-foreground">
          <Logo class="h-6 w-6" /> A FlowNexa product
        </p>
        <p class="eyebrow mt-6">
          <span class="h-2 w-2 rounded-full bg-accent"></span>{c.status}
        </p>
        <h1 class="mt-3 text-5xl md:text-6xl">{c.name}</h1>
        <p class="mt-4 text-2xl leading-snug font-medium">{c.headline}</p>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted-foreground">{c.intro}</p>
        <a href="#waitlist" class="btn btn-primary mt-8" data-track="cricnexa_hero_waitlist">
          Join the waitlist <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>

      <!-- Abstract graphic, deliberately not a fake product screenshot. -->
      <div class="relative mx-auto aspect-square w-full max-w-md" aria-hidden="true">
        <svg viewBox="0 0 400 400" class="h-full w-full">
          <defs>
            <radialGradient id="cn-glow" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="var(--color-accent)" stop-opacity="0.28"></stop>
              <stop offset="100%" stop-color="var(--color-accent)" stop-opacity="0"></stop>
            </radialGradient>
          </defs>
          <circle cx="200" cy="200" r="200" fill="url(#cn-glow)"></circle>
          <circle cx="200" cy="200" r="150" fill="none" stroke="var(--color-border)" stroke-width="2"></circle>
          <circle cx="200" cy="200" r="100" fill="none" stroke="var(--color-border)" stroke-width="2" stroke-dasharray="4 8"></circle>
          <circle cx="200" cy="200" r="58" fill="var(--color-accent)"></circle>
          <path d="M163 165c22 22 22 48 0 70M237 165c-22 22-22 48 0 70" fill="none" stroke="var(--color-accent-foreground)" stroke-width="3" stroke-dasharray="5 5" stroke-linecap="round"></path>
          <g fill="var(--color-foreground)" opacity="0.8">
            <rect x="60" y="300" width="14" height="40" rx="3"></rect>
            <rect x="84" y="270" width="14" height="70" rx="3"></rect>
            <rect x="108" y="285" width="14" height="55" rx="3"></rect>
            <rect x="132" y="250" width="14" height="90" rx="3"></rect>
          </g>
          <polyline points="250,110 285,90 315,100 345,60" fill="none" stroke="var(--color-foreground)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" opacity="0.8"></polyline>
          <circle cx="345" cy="60" r="6" fill="var(--color-accent)"></circle>
        </svg>
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-muted/40 py-16" aria-labelledby="cn-planned">
    <div class="container-page">
      <h2 id="cn-planned" class="text-3xl">What we're building</h2>
      <ul class="mt-8 grid gap-5 md:grid-cols-3">
        {
          c.plannedFeatures.map((f) => (
            <li class="card p-6">
              <h3 class="text-lg">{f.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{f.body}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-sm text-muted-foreground">
        <strong class="text-foreground">For:</strong> {c.audience.join(" · ")}
      </p>
      <p class="mt-2 text-sm text-muted-foreground">{c.disclaimer}</p>
    </div>
  </section>

  <section id="waitlist" class="container-page scroll-mt-24 py-16 md:py-24" aria-labelledby="cn-waitlist">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow">Early access</p>
        <h2 id="cn-waitlist" class="mt-3 text-3xl md:text-4xl">Join the waitlist</h2>
        <p class="mt-4 text-muted-foreground">
          Get early access and help shape what we build. We're especially keen to hear from clubs and
          academies who score matches every week.
        </p>
      </div>
      <div class="card p-6 sm:p-8 lg:col-span-7">
        <WaitlistForm />
      </div>
    </div>
  </section>
</BaseLayout>
