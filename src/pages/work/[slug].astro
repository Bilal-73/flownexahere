---
import { render } from "astro:content";
import { Picture, Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import VideoEmbed from "@/components/VideoEmbed.astro";
import Icon from "@/components/Icon.astro";
import { getCaseStudies, ogImageFor, statusLabel, typeLabel, type Project } from "@/lib/projects";
import { bookingHref, site, whatsappUrl } from "@/config/site";
import { SERVICE_TAG_LABELS } from "@/content.config";
import { breadcrumbLd } from "@/lib/schema";

export async function getStaticPaths() {
  const studies = await getCaseStudies();
  return studies.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: studies[(i + 1) % studies.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}
const { project, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const isDraft = d.status === "draft";
const url = new URL(`/work/${project.id}/`, site.url).toString();
const booking = bookingHref();

const articleLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "@id": `${url}#work`,
  name: d.title,
  headline: d.title,
  description: d.summary,
  url,
  image: new URL(ogImageFor(project), site.url).toString(),
  genre: typeLabel(project),
  keywords: [...d.tech, ...d.services.map((s) => SERVICE_TAG_LABELS[s])].join(", "),
  creator: { "@type": "Organization", "@id": `${site.url}/#organization`, name: site.name },
  ...(d.date ? { dateCreated: d.date.toISOString().slice(0, 10) } : {}),
};
---

<BaseLayout
  title={`${d.title} | FlowNexa case study`}
  description={d.summary}
  image={ogImageFor(project)}
  imageAlt={`${d.title}: ${d.tag ?? "FlowNexa case study"}`}
  type="article"
  noindex={isDraft}
  jsonLd={[
    articleLd,
    breadcrumbLd([
      { name: "Home", path: "/" },
      { name: "Work", path: "/work/" },
      { name: d.title, path: `/work/${project.id}/` },
    ]),
  ]}
>
  {
    isDraft && (
      <div class="bg-yellow-300 px-4 py-2 text-center text-sm font-bold text-black">
        DRAFT: visible in dev only. Excluded from the production build and sitemap.
      </div>
    )
  }
  <article>
    <header class="container-page pt-10 md:pt-14">
      <nav aria-label="Breadcrumb" class="text-sm text-muted-foreground">
        <a href="/work/" class="inline-flex items-center gap-1.5 hover:text-accent"><Icon name="arrow-left" class="h-4 w-4" /> All work</a>
      </nav>
      <div class="mt-6 flex flex-wrap items-center gap-2">
        <span class="rounded-full bg-inverse px-3 py-1 text-xs font-semibold tracking-wide text-inverse-foreground uppercase">{statusLabel(project)}</span>
        <span class="chip">{typeLabel(project)}</span>
        {d.tag && <span class="chip">{d.tag}</span>}
      </div>
      <h1 class="mt-4 max-w-4xl text-4xl leading-tight md:text-5xl">{d.title}</h1>
      <p class="mt-4 max-w-3xl text-xl leading-relaxed text-muted-foreground">{d.summary}</p>
      {
        d.type === "demo" && (
          <p class="mt-4 max-w-3xl text-sm text-muted-foreground">
            <strong class="text-foreground">Demo build:</strong> created to show how this kind of system works. No client name, figures or testimonials are implied.
          </p>
        )
      }
      <div class="mt-6 flex flex-wrap gap-3">
        {d.links.demo && <a href={d.links.demo} class="btn btn-primary" target="_blank" rel="noopener" data-track="case_live_demo"><Icon name="external" class="h-4 w-4" /> Live demo</a>}
        {d.links.repo && <a href={d.links.repo} class="btn btn-secondary" target="_blank" rel="noopener" data-track="case_repo"><Icon name="github" class="h-4 w-4" /> Source code</a>}
      </div>
    </header>

    {
      (d.banner || d.cover) && (
        <div class="container-page mt-10">
          <div class="overflow-hidden rounded-[var(--radius-card)] border border-border bg-card">
            {d.banner ? (
              <Picture src={d.banner} alt={d.bannerAlt ?? `${d.title} banner`} formats={["avif"]} fallbackFormat="webp" widths={[640, 1024, 1440, 1920].filter((w) => w <= d.banner!.width)} sizes="(min-width: 1280px) 1232px, 100vw" loading="eager" fetchpriority="high" class="h-auto w-full" />
            ) : (
              <Picture src={d.cover!} alt={d.coverAlt ?? `${d.title} preview`} formats={["avif"]} fallbackFormat="webp" widths={[640, 960, 1260].filter((w) => w <= d.cover!.width)} sizes="(min-width: 1280px) 1232px, 100vw" loading="eager" fetchpriority="high" class="h-auto w-full" />
            )}
          </div>
        </div>
      )
    }

    {
      d.facts.length > 0 && (
        <div class="container-page mt-8">
          <dl class="grid overflow-hidden rounded-[var(--radius-card)] bg-inverse text-inverse-foreground sm:grid-cols-3">
            {d.facts.map((f) => (
              <div class="border-white/10 p-5 not-last:border-b sm:not-last:border-r sm:not-last:border-b-0">
                <dt class="text-xs font-semibold tracking-[0.12em] text-inverse-muted uppercase">{f.label}</dt>
                <dd class="mt-1.5 font-semibold">{f.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      )
    }

    <div class="container-page mt-4 grid gap-12 pb-16 lg:grid-cols-12">
      <div class="prose-fn lg:col-span-8">
        <Content />

        {
          d.links.video && (
            <>
              <h2>Video walkthrough</h2>
              <VideoEmbed url={d.links.video} title={`${d.title} walkthrough`} />
            </>
          )
        }

        {
          (d.cover && d.banner) || d.gallery.length > 0 ? (
            <>
              <h2>Screenshots</h2>
              <ul class="!mt-6 grid list-none gap-4 !pl-0 sm:grid-cols-2">
                {d.cover && d.banner && (
                  <li class="!mt-0 overflow-hidden rounded-xl border border-border bg-card">
                    <Image src={d.cover} alt={d.coverAlt ?? `${d.title} screenshot`} widths={[480, 800, 1260].filter((w) => w <= d.cover!.width)} sizes="(min-width: 1024px) 400px, 100vw" class="h-auto w-full" />
                  </li>
                )}
                {d.gallery.map((g) => (
                  <li class="!mt-0 overflow-hidden rounded-xl border border-border bg-card">
                    <Image src={g.src} alt={g.alt} widths={[480, 800, 1200].filter((w) => w <= g.src.width)} sizes="(min-width: 1024px) 400px, 100vw" class="h-auto w-full" />
                  </li>
                ))}
              </ul>
            </>
          ) : null
        }
      </div>

      <aside class="lg:col-span-4">
        <div class="space-y-6 lg:sticky lg:top-24">
          {
            d.tech.length > 0 && (
              <div class="card p-5">
                <h2 class="text-sm font-semibold tracking-[0.12em] text-muted-foreground uppercase">Tech</h2>
                <ul class="mt-3 flex flex-wrap gap-1.5">
                  {d.tech.map((t) => <li class="chip">{t}</li>)}
                </ul>
              </div>
            )
          }
          <div class="card p-5">
            <h2 class="text-sm font-semibold tracking-[0.12em] text-muted-foreground uppercase">Services</h2>
            <ul class="mt-3 space-y-1.5 text-sm">
              {d.services.map((s) => <li>{SERVICE_TAG_LABELS[s]}</li>)}
            </ul>
          </div>
          <div class="rounded-[var(--radius-card)] bg-inverse p-6 text-inverse-foreground">
            <h2 class="text-xl">Want something like this?</h2>
            <p class="mt-2 text-sm text-inverse-muted">Tell us about your workflow. Free 15-minute call, fixed quote, code you own.</p>
            <div class="mt-5 flex flex-col gap-2">
              <a href={booking} class="btn btn-inverse" data-track="case_book_call" {...(booking.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}>Book a free call</a>
              <a href={whatsappUrl(`Hi FlowNexa, I saw "${d.title}" and want something similar.`)} class="btn border border-white/25 text-inverse-foreground hover:border-white" target="_blank" rel="noopener" data-track="case_whatsapp">
                <Icon name="whatsapp" class="h-4 w-4" /> WhatsApp
              </a>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </article>

  {
    next.id !== project.id && (
      <section class="border-t border-border bg-muted/40 py-14" aria-label="Next case study">
        <div class="container-page grid gap-8 md:grid-cols-2 md:items-center">
          <div>
            <p class="eyebrow">Next case study</p>
            <p class="mt-3 text-3xl font-semibold tracking-tight">{next.data.title}</p>
          </div>
          <ProjectCard project={next} />
        </div>
      </section>
    )
  }
</BaseLayout>
