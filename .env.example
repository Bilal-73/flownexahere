# Copy to .env for local testing (never commit .env).
# In production, set these in Netlify → Site configuration → Environment variables,
# then trigger a new deploy (they are read at build time).

# Cloudflare Web Analytics (free, cookieless). Leave empty to disable.
# Get it: Cloudflare dashboard → Analytics & Logs → Web Analytics → Add a site →
# choose "manual / JS snippet" and copy the token value from the snippet.
PUBLIC_CF_BEACON_TOKEN=

# Google Analytics 4 measurement ID (optional, off by default), e.g. G-ABC123XYZ.
# When set, GA4 loads only after a visitor accepts the consent notice.
PUBLIC_GA_ID=
